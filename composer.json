{
    "name": "omnibus/dtdc",
    "type": "library",
    "description": "Omnibus DTDC: consignments and labels, cancellations, tracking - the DTDC customer integration API.",
    "keywords": [
        "shipping",
        "carrier",
        "omnibus",
        "dtdc"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/omnibus": "^2.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnibus\\Dtdc\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnibus\\Dtdc\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
